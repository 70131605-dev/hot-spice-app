{
  "expo": {
    "name": "hotspice-frontend",
    "slug": "hotspice-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpeg",
    "scheme": "hotspicefrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#EDE8D0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF3D00",
        "foregroundImage": "./assets/images/logo.jpeg",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.jpeg",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EDE8D0",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hot & Spice uses your location to set your delivery address and find the nearest restaurant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
